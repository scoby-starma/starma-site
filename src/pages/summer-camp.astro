---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import SmsConsent from '../components/SmsConsent.astro';
const title = "Summer Camp in Gainesville, FL (Ages 5-12) | Star Martial Arts";
const description = "Summer camp for ages 5–12, 7:30 AM to 6:15 PM: themed weeks, pool days, park trips, Friday field trips included, and martial arts twice a week.";
const schema = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What ages can attend Summer Camp?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our Summer Camp is designed for children ages 5–12."
      }
    },
    {
      "@type": "Question",
      "name": "What are your camp hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Camp runs from 7:30 AM to 6:15 PM."
      }
    },
    {
      "@type": "Question",
      "name": "Does my child need martial arts experience?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No prior martial arts experience is required. Campers can participate in beginner-friendly martial arts activities."
      }
    },
    {
      "@type": "Question",
      "name": "Is martial arts included?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Campers participate in martial arts instruction twice per week."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer field trips?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Our traditional camp experience includes pool outings, local park trips, movie experiences, and special Friday activities. Field trips are included in Summer Camp tuition. Refer to the current camp calendar for confirmed outings."
      }
    },
    {
      "@type": "Question",
      "name": "Can I choose specific weeks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Families can select available weeks based on the current registration options and deadlines."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have multiple locations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We have West Gainesville and North Gainesville locations. Contact our team to confirm availability for your preferred weeks and location."
      }
    },
    {
      "@type": "Question",
      "name": "How much does camp cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing varies by location and availability, and you can lock in your pricing by registering early. Current pricing and available promotions can be found through our registration process or by contacting our team: West Gainesville, 352-505-1499 or North Gainesville, 352-672-6356."
      }
    },
    {
      "@type": "Question",
      "name": "What should my child bring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We will provide an official packing list and any specific requirements for field trips and themed activities."
      }
    }
  ]
}];
---
<BaseLayout title={title} description={description} image="/images/cph.webp" schema={schema} pageClass="pg-camp">
<section class="ah"><div class="w kh"><div class="rv"><p class="bc"><a href="/">Home</a> / Programs / Summer Camp</p><p class="lab eb">Gainesville’s Best Summer Camp</p><h1 class="d" style="font-size:clamp(48px,7vw,92px);margin:16px 0 20px">Their best summer starts here.</h1><p class="lead" style="font-size:19px;max-width:560px">Big adventures. New friendships. Unforgettable memories. At Star Martial Arts, every week brings something new to discover, with exciting themes, martial arts, field trips, games, and experiences that make summer something special.</p><div class="btns" style="margin-top:28px"><a class="btn p" href="#camp-register">Explore Registration</a><a class="btn ow" href="#camp-week">Discover the Adventure</a></div><div class="chips"><span>Ages 5–12</span><span>7:30 AM – 6:15 PM</span><span>Weekly Adventures &amp; Field Trips</span></div></div>
<div class="im rv has-bgi" style="height:460px;border-radius:12px;"><img class="bgi" src="/images/cph.webp" alt="Three campers laughing together on a tire swing at a local park" width="1400" height="636" fetchpriority="high" decoding="async" style="object-position:center 50%"></div></div></section>

<section class="sec df"><div class="w"><p class="lab eb rv">This isn’t your average summer camp</p><h2 class="hdg rv" style="margin:14px 0 14px">More than a summer. A summer to remember.</h2><p class="sub rv">Summer should be more than watching the clock until pickup. It’s a chance to explore new interests, build friendships, try something new, and create stories your child will be excited to share.</p>
<div class="cmp" id="cmp2"><div class="cmp-a"><h3>A typical summer arrangement</h3><ul><li><b>Daily activities</b>Recess, arts and crafts, and board games, repeated twice a day</li><li><b>Weekly variety</b>None</li><li><b>Physical activity</b>Varies by provider</li><li><b>Field trips</b>Only once a week, and it costs extra to attend</li><li><b>Social development</b>None. Just the luck of the draw of who is there that week</li><li><b>Life skills</b>Not a focus</li><li><b>Hours</b>8:00 AM – 5:00 PM</li><li><b>Environment</b>A classroom with multiple age groups, on campus only</li></ul></div><div class="cmp-b"><h3>The StarMA experience</h3><ul><li><b>Daily activities</b>Engaging games, themed activities, and creative experiences</li><li><b>Weekly variety</b>Different weekly themes and special experiences</li><li><b>Physical activity</b>Martial arts twice weekly, games, and active experiences</li><li><b>Field trips</b>Planned outings and special activities throughout the week, included in tuition</li><li><b>Social development</b>Teamwork, friendships, and cooperative challenges</li><li><b>Life skills</b>Respect, resilience, responsibility, and cooperation reinforced through activities</li><li><b>Hours</b>7:30 AM to 6:15 PM</li><li><b>Environment</b>Active Supervision and a culture centered on positive experiences</li></ul></div></div><p class="dn">Camp offerings vary. This comparison illustrates common arrangements and does not make universal claims.</p>
<p class="cls rv">We’re not just filling summer days. We’re filling them with memories.</p><a class="btn p" href="#camp-register">Explore Registration</a></div></section>

<section class="sec" id="camp-week"><div class="w"><p class="lab eb rv">A week of adventure</p><h2 class="hdg rv" style="margin:14px 0 14px">Every week is a new adventure.</h2><p class="sub rv">At StarMA, we believe variety is what makes summer exciting. Our weekly themes transform familiar activities into new experiences, giving campers something different to look forward to.</p>
<div class="tabs" role="tablist" aria-label="Days of the camp week" id="tabs"><button class="tab" role="tab" id="t0" aria-selected="true" aria-controls="dp0" tabindex="0">Monday</button><button class="tab" role="tab" id="t1" aria-selected="false" aria-controls="dp1" tabindex="-1">Tuesday</button><button class="tab" role="tab" id="t2" aria-selected="false" aria-controls="dp2" tabindex="-1">Wednesday</button><button class="tab" role="tab" id="t3" aria-selected="false" aria-controls="dp3" tabindex="-1">Thursday</button><button class="tab" role="tab" id="t4" aria-selected="false" aria-controls="dp4" tabindex="-1">Friday</button></div><div class="dp" id="dp0" role="tabpanel" aria-labelledby="t0" style="--a:#2FA4E7"><div><h4>Make a splash</h4><h3>Monday: Pool Day</h3><p style="font-size:17px;color:#444">Mondays feature a pool outing as part of our traditional Summer Camp experience. It’s a day for fun, friendships, and enjoying summer together.</p></div><div class="im has-bgi" style="height:260px;border-radius:10px"><img class="bgi" src="/images/cp1.webp" alt="Campers: pool trip" width="640" height="853" loading="lazy" decoding="async"></div></div><div class="dp" id="dp1" role="tabpanel" aria-labelledby="t1" style="--a:#3DB36B" hidden><div><h4>Outside and active</h4><h3>Tuesday: Local Park Day</h3><p style="font-size:17px;color:#444">Tuesdays take campers to a local park for outdoor fun, plus themed games and team challenges that vary by camp week.</p></div><div class="im has-bgi" style="height:260px;border-radius:10px"><img class="bgi" src="/images/cp2.webp" alt="Campers: park trip" width="720" height="540" loading="lazy" decoding="async"></div></div><div class="dp" id="dp2" role="tabpanel" aria-labelledby="t2" style="--a:#FFC72C" hidden><div><h4>Lights. Camera. Summer.</h4><h3>Wednesday: Movie Day</h3><p style="font-size:17px;color:#444">Wednesday traditionally features a movie outing or movie experience, a special activity to share with friends.</p></div><div class="im has-bgi" style="height:260px;border-radius:10px"><img class="bgi" src="/images/cp3.webp" alt="Campers: movie experience" width="720" height="540" loading="lazy" decoding="async"></div></div><div class="dp" id="dp3" role="tabpanel" aria-labelledby="t3" style="--a:#FF8A00" hidden><div><h4>Try something new</h4><h3>Thursday: Local Park Day</h3><p style="font-size:17px;color:#444">Thursdays are another trip to a local park, with creative projects, new skills, and group activities that vary by camp week.</p></div><div class="im has-bgi" style="height:260px;border-radius:10px"><img class="bgi" src="/images/cp25.webp" alt="Campers: playground fun" width="640" height="853" loading="lazy" decoding="async"></div></div><div class="dp" id="dp4" role="tabpanel" aria-labelledby="t4" style="--a:#E10600" hidden><div><h4>Finish the week with an adventure</h4><h3>Friday: Specialty Field Trip</h3><p style="font-size:17px;color:#444">Fridays feature a special trip or experience connected to the camp schedule, ending each week with something memorable.</p></div><div class="im has-bgi" style="height:260px;border-radius:10px"><img class="bgi" src="/images/cp16.webp" alt="Campers: field trip" width="720" height="540" loading="lazy" decoding="async"></div></div>
<p style="margin-top:20px;font-size:17px"><b>Martial arts, twice a week.</b> Campers take part in martial arts instruction twice per week, woven into the weekly experience.</p><p class="dn">Activities and outings are subject to the published weekly schedule and operational changes.</p></div></section>

<section class="sec dk"><div class="w"><p class="lab eb rv">A look at our camp adventures</p><h2 class="hdg rv" style="margin:14px 0 14px">Ten weeks. Endless possibilities.</h2><p style="color:#E4E4E4;max-width:660px;font-size:18px">From superhero missions to science experiments, ninja challenges, and imaginative adventures, every week at StarMA brings a new world of possibilities.</p><div class="thg" id="thg"><div class="thc" style="--a:#2FA4E7"><div><small>WEEK EXAMPLE 01</small><h3>Hero Academy</h3><p>Train like a hero, take on exciting challenges, and discover the power of teamwork.</p></div></div><div class="thc" style="--a:#3DB36B"><div><small>WEEK EXAMPLE 02</small><h3>Pokémon</h3><p>Explore imaginative games, friendly competitions, and Pokémon-inspired adventures.</p></div></div><div class="thc" style="--a:#FFC72C"><div><small>WEEK EXAMPLE 03</small><h3>MythBusters</h3><p>Put curiosity to the test with experiments, challenges, and exciting discoveries.</p></div></div><div class="thc" style="--a:#FF8A00"><div><small>WEEK EXAMPLE 04</small><h3>Galactic Quest</h3><p>Journey into space-inspired missions and team adventures.</p></div></div><div class="thc" style="--a:#E10600"><div><small>WEEK EXAMPLE 05</small><h3>Minecraft</h3><p>Bring creativity and teamwork into real-world Minecraft-inspired challenges.</p></div></div><div class="thc" style="--a:#2FA4E7"><div><small>WEEK EXAMPLE 06</small><h3>Avatar Elements</h3><p>Explore the elements through movement, games, and creative activities.</p></div></div><div class="thc" style="--a:#3DB36B"><div><small>WEEK EXAMPLE 07</small><h3>Mythical Creatures</h3><p>Discover a world of legendary creatures, imagination, and adventure.</p></div></div><div class="thc" style="--a:#FFC72C"><div><small>WEEK EXAMPLE 08</small><h3>Ninja Warriors</h3><p>Test agility, determination, and teamwork through ninja-inspired challenges.</p></div></div><div class="thc" style="--a:#FF8A00"><div><small>WEEK EXAMPLE 09</small><h3>Spy School</h3><p>Take on secret missions, solve puzzles, and work together to complete challenges.</p></div></div><div class="thc" style="--a:#E10600"><div><small>WEEK EXAMPLE 10</small><h3>ToonTown</h3><p>Celebrate imagination, laughter, and cartoon-inspired fun.</p></div></div></div><p class="dn" style="color:#aaa">These are examples from our 2026 camp lineup, not the confirmed 2027 themes. Official weekly themes and dates will replace them when the upcoming calendar is supplied.</p></div></section>

<section class="sec"><div class="w"><p class="lab eb rv">A day in the life of a StarMA camper</p><h2 class="hdg rv" style="margin:14px 0 14px">From drop-off to pickup, the adventure never stops.</h2><ol class="tl" id="tl2"><li><span class="n" aria-hidden="true">1</span><div class="c"><div><h4>Start the day with a smile</h4><h3>Morning Arrival</h3><p>Camp opens at 7:30 AM. Children arrive, connect with friends, and begin their camp day.</p></div><div class="im has-bgi" style="min-height:220px;border-radius:8px"><img class="bgi" src="/images/cp9.webp" alt="Campers smiling beside a tall wooden block tower" width="640" height="853" loading="lazy" decoding="async"></div></div></li><li><span class="n" aria-hidden="true">2</span><div class="c"><div><h4>Let the adventure begin</h4><h3>Morning Activities</h3><p>Games, creative activities, team challenges, and themed experiences help start the day.</p></div><div class="im has-bgi" style="min-height:220px;border-radius:8px"><img class="bgi" src="/images/cp10.webp" alt="Campers building with bricks at a museum table" width="720" height="540" loading="lazy" decoding="async"></div></div></li><li><span class="n" aria-hidden="true">3</span><div class="c"><div><h4>Something new to discover</h4><h3>Special Activities and Outings</h3><p>Depending on the day, campers may enjoy pool outings, local park trips, movie experiences, special field trips, or themed activities.</p></div><div class="im has-bgi" style="min-height:220px;border-radius:8px"><img class="bgi" src="/images/cp11.webp" alt="A big group of campers outside a museum field trip" width="640" height="853" loading="lazy" decoding="async"></div></div></li><li><span class="n" aria-hidden="true">4</span><div class="c"><div><h4>Build confidence while having fun</h4><h3>Martial Arts and Movement</h3><p>Campers receive martial arts instruction twice per week and enjoy opportunities for physical activity.</p></div><div class="im has-bgi" style="min-height:220px;border-radius:8px"><img class="bgi" src="/images/cp12.webp" alt="A camper in a ready stance during martial arts class" width="640" height="853" loading="lazy" decoding="async"></div></div></li><li><span class="n" aria-hidden="true">5</span><div class="c"><div><h4>More fun. More friendships.</h4><h3>Afternoon Adventures</h3><p>Games, creative activities, cooperative challenges, and social experiences continue throughout the afternoon.</p></div><div class="im has-bgi" style="min-height:220px;border-radius:8px"><img class="bgi" src="/images/cp13.webp" alt="Two campers playing a game together" width="720" height="960" loading="lazy" decoding="async"></div></div></li><li><span class="n" aria-hidden="true">6</span><div class="c"><div><h4>Home with stories to tell</h4><h3>Parent Pickup</h3><p>Parents can pick up as late as 6:15 PM.</p></div><div class="ph">Photo: parent pickup</div></div></li></ol><p class="dn">A conceptual look at a camp day, not a confirmed minute-by-minute schedule.</p></div></section>

<section class="sec df"><div class="w"><p class="lab eb rv">The StarMA difference</p><h2 class="hdg rv" style="margin:14px 0 32px">The fun is real. So is our purpose.</h2><div class="pl g4">
<div class="pi rv"><h3>Active Supervision</h3><p>Our team is expected to actively engage with campers, monitor activities, and help create a positive environment. Never just stand there.</p></div>
<div class="pi rv"><h3>Friendships &amp; Belonging</h3><p>Camp gives children chances to connect with others, practice cooperation, and build friendships.</p></div>
<div class="pi rv"><h3>Confidence &amp; Life Skills</h3><p>Activities and martial arts reinforce respect, responsibility, resilience, empathy, and teamwork.</p></div>
<div class="pi rv"><h3>Memories That Last</h3><p>From special trips to themed challenges and shared experiences, we aim for the summer memories kids love talking about.</p></div></div></div></section>

<section class="sec dk"><div class="w"><p class="lab eb rv">Field trips and special experiences</p><h2 class="hdg rv" style="margin:14px 0 0">The best stories happen outside the ordinary.</h2><div class="ft3">
<div class="rv"><div class="im has-bgi" style="height:280px;border-radius:12px"><img class="bgi" src="/images/cp6.webp" alt="Campers in life vests at the pool" width="640" height="853" loading="lazy" decoding="async"></div><h3>Pool Adventures</h3><p>Our traditional Monday pool outings let campers enjoy summer fun with friends.</p></div>
<div class="rv"><div class="im has-bgi" style="height:280px;border-radius:12px"><img class="bgi" src="/images/cp2.webp" alt="Campers at a local park playground" width="720" height="540" loading="lazy" decoding="async"></div><h3>Park Adventures</h3><p>Tuesday and Thursday trips to a local park give campers room to run, play, and explore.</p></div>
<div class="rv"><div class="im has-bgi" style="height:280px;border-radius:12px"><img class="bgi" src="/images/cp7.webp" alt="Campers watching a movie together" width="640" height="853" loading="lazy" decoding="async"></div><h3>Movie Experiences</h3><p>Wednesday movie activities give campers a special shared experience.</p></div>
<div class="rv"><div class="im has-bgi" style="height:280px;border-radius:12px"><img class="bgi" src="/images/cp24.webp" alt="Campers solving clues with lanterns in an escape room on a Friday field trip" width="640" height="853" loading="lazy" decoding="async"></div><h3>Friday Field Trips</h3><p>Our specialty Friday experiences bring extra variety and excitement to each camp week.</p></div></div>
<p style="color:#fff;font-size:20px;margin-top:28px"><b>Field trips are included in Summer Camp tuition.</b></p><p class="dn" style="color:#aaa">Activities are subject to the confirmed camp calendar and may change.</p></div></section>

<section class="sec"><div class="w"><p class="lab eb rv">Flexibility for families</p><h2 class="hdg rv" style="margin:14px 0 32px">Big adventures. Convenient hours.</h2><div class="pl g4">
<div class="pi rv"><h3>Ages 5–12</h3><p>Designed for elementary-age campers.</p></div><div class="pi rv"><h3>7:30 AM – 6:15 PM</h3><p>Extended camp hours for working families.</p></div><div class="pi rv"><h3>Weekly Camp Options</h3><p>Families can select available camp weeks based on the current enrollment schedule.</p></div><div class="pi rv"><h3>Two Gainesville Locations</h3><p>West Gainesville and North Gainesville.</p></div></div>
<div class="lc2" style="margin-top:24px" id="clocs"><div class="pi"><h3>West Gainesville</h3><p>500 NW 60th St, Suite A<br>Gainesville, FL 32607<br><a href="tel:3525051499">352-505-1499</a><br><a href="mailto:westgv@mystarma.com">westgv@mystarma.com</a></p></div><div class="pi"><h3>North Gainesville</h3><p>5000 NW 34th Blvd, Suite 5<br>Gainesville, FL 32605<br><a href="tel:3526726356">352-672-6356</a><br><a href="mailto:northgv@mystarma.com">northgv@mystarma.com</a></p></div></div></div></section>

<section class="sec df" id="camp-register"><div class="w"><p class="lab eb rv">Summer camp registration</p><h2 class="hdg rv" style="margin:14px 0 14px">Your summer adventure starts with one click.</h2><p class="sub rv">Choose your location to see your registration options.</p>
<div class="rg" id="rg" role="group" aria-label="Choose your location"><button type="button" class="rb" data-k="west" aria-pressed="false"><b>West Gainesville</b><span>500 NW 60th St, Suite A</span></button><button type="button" class="rb" data-k="north" aria-pressed="false"><b>North Gainesville</b><span>5000 NW 34th Blvd, Suite 5</span></button></div><div class="ro" id="ro" aria-live="polite" hidden=""></div><div id="promo"></div>
<p class="sub" style="margin-top:20px;font-size:17px"><b>Lock in your pricing early!</b> Registering early secures your family’s rate. Pricing varies by location and availability, so current pricing and available promotions can be found through our registration process or by contacting your location.</p></div></section>

<section class="sec dk"><div class="w"><p class="lab eb rv">Real camp moments</p><h2 class="hdg rv" style="margin:14px 0 0">The moments they’ll remember.</h2><div class="ga" id="cga"><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp6.webp" alt="Pool trips" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Pool trips</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp7.webp" alt="Movie experiences" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Movie experiences</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp14.webp" alt="Friday field trips" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Friday field trips</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp15.webp" alt="Martial arts classes" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Martial arts classes</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp16.webp" alt="Group games" width="720" height="540" loading="lazy" decoding="async"><figcaption class="cap">Group games</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp17.webp" alt="Creative projects" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Creative projects</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp18.webp" alt="Camp friendships" width="720" height="540" loading="lazy" decoding="async"><figcaption class="cap">Camp friendships</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp19.webp" alt="Theme-week activities" width="720" height="540" loading="lazy" decoding="async"><figcaption class="cap">Theme-week activities</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp20.webp" alt="Building challenges" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Building challenges</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp21.webp" alt="Outdoor fun" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">Outdoor fun</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp22.webp" alt="Museum discoveries" width="720" height="540" loading="lazy" decoding="async"><figcaption class="cap">Museum discoveries</figcaption></figure><figure class="im has-bgi" style="height:220px"><img class="bgi" src="/images/cp23.webp" alt="The camp crew" width="640" height="853" loading="lazy" decoding="async"><figcaption class="cap">The camp crew</figcaption></figure></div><p class="dn" style="color:#aaa"></p></div></section>

<section class="sec"><div class="w" style="max-width:820px"><p class="lab eb rv">Questions parents ask</p><h2 class="hdg rv" style="margin:14px 0 24px">Good to know</h2><div id="cfaq"><details><summary>What ages can attend Summer Camp?</summary><p>Our Summer Camp is designed for children ages 5–12.</p></details><details><summary>What are your camp hours?</summary><p>Camp runs from 7:30 AM to 6:15 PM.</p></details><details><summary>Does my child need martial arts experience?</summary><p>No prior martial arts experience is required. Campers can participate in beginner-friendly martial arts activities.</p></details><details><summary>Is martial arts included?</summary><p>Yes! Campers participate in martial arts instruction twice per week.</p></details><details><summary>Do you offer field trips?</summary><p>Yes! Our traditional camp experience includes pool outings, local park trips, movie experiences, and special Friday activities. Field trips are included in Summer Camp tuition. Refer to the current camp calendar for confirmed outings.</p></details><details><summary>Can I choose specific weeks?</summary><p>Families can select available weeks based on the current registration options and deadlines.</p></details><details><summary>Do you have multiple locations?</summary><p>Yes! We have West Gainesville and North Gainesville locations. Contact our team to confirm availability for your preferred weeks and location.</p></details><details><summary>How much does camp cost?</summary><p>Pricing varies by location and availability, and you can lock in your pricing by registering early. Current pricing and available promotions can be found through our registration process or by contacting our team: <a href="tel:3525051499">West Gainesville, 352-505-1499</a> or <a href="tel:3526726356">North Gainesville, 352-672-6356</a>.</p></details><details><summary>What should my child bring?</summary><p>We will provide an official packing list and any specific requirements for field trips and themed activities.</p></details></div></div></section>

<section class="sec dk" id="camp-request"><div class="w" style="text-align:center"><h2 class="hdg" style="max-width:16ch;margin:0 auto 16px">Don’t just plan their summer. Make it unforgettable.</h2><p style="color:#E4E4E4;max-width:600px;margin:0 auto 24px;font-size:18px">New adventures, new friendships, exciting experiences, and memories that last. Give your child a summer they’ll be excited to tell you about every day.</p><div class="btns" style="justify-content:center"><a class="btn p" href="#camp-register">Explore Registration</a><a class="btn ow" href="#cname">Ask About Camp</a></div>
<form class="fm" id="cf" novalidate=""><h3 class="d" style="font-size:36px;margin-bottom:10px">Ask about camp</h3><p class="nb" role="note">Integration required: this form validates your answers but is not connected to a form service yet, so nothing is submitted from this prototype.</p>
