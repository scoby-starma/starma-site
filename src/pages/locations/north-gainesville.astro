---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { locationSchema } from '../../config/schema';
import { SCHOOLS } from '../../config/site';
const schoolsFor = (k: string) => SCHOOLS.filter((s) => (s[2] as string[]).includes(k)).map((s) => s[0] as string);
const title = "Martial Arts in North Gainesville, FL (NW 34th Blvd) | Star Martial Arts";
const description = "Star Martial Arts North Gainesville, 5000 NW 34th Blvd, Suite 5. Kids and adult martial arts, After School pickup, and Summer Camp. Call 352-672-6356.";
const schema = [locationSchema('north')];
---
<BaseLayout title={title} description={description} image="/images/mapn.webp" schema={schema} pageClass="pg-north">
<section class="ah"><div class="w kh"><div class="rv"><p class="bc"><a href="/">Home</a> / <a href="/locations/">Locations</a> / North Gainesville</p><p class="lab eb">Star Martial Arts · North Gainesville</p><h1 class="d" style="font-size:clamp(48px,7vw,88px);margin:16px 0 20px">North Gainesville</h1><p class="lead" style="font-size:19px;max-width:540px">Our newest location brings martial arts, After School, and Summer Camp to North Gainesville. Same StarMA standards, closer to home.</p><div class="btns" style="margin-top:28px"><button class="btn p" data-gs data-l="north">Get Started at North</button><a class="btn ow" href="tel:3526726356">Call 352-672-6356</a></div><div class="chips"><span>5000 NW 34th Blvd, Suite 5</span><span>All four programs</span></div></div>
<div class="lpm rv has-bgi"><img class="bgi" src="/images/mapn.webp" alt="Map showing Star Martial Arts North Gainesville" width="900" height="799" fetchpriority="high" decoding="async"></div></div></section>

<section class="sec dk lpd"><div class="w kb"><div class="rv"><p class="lab eb">Visit us</p><h2 class="hdg" style="margin:14px 0 4px">Find North Gainesville</h2><dl><dt>Address</dt><dd>5000 NW 34th Blvd, Suite 5<br>Gainesville, FL 32605</dd><dt>Phone</dt><dd><a href="tel:3526726356">352-672-6356</a></dd><dt>Email</dt><dd><a href="mailto:northgv@mystarma.com">northgv@mystarma.com</a></dd><dt>Schedule</dt><dd>Multiple class times Monday through Friday. You’ll see current times after you choose a program in Get Started.</dd></dl><div class="btns"><a class="btn p" href="https://www.google.com/maps/search/?api=1&amp;query=5000+NW+34th+Blvd+Suite+5+Gainesville+FL+32605" target="_blank" rel="noopener">Get Directions</a><a class="btn ow" href="mailto:northgv@mystarma.com">Email This Location</a></div></div>
<div class="rv"><p class="lab eb">Before your first visit</p><ul style="margin-top:14px"><li>Arrive a few minutes early. At StarMA, early is on time.</li><li>Wear comfortable workout clothes. Your first uniform is provided at no cost when you enroll.</li><li>Bring water and any questions you have. Our team is happy to help.</li><li>Parents are welcome to watch and meet the instructors.</li></ul></div></div></section>

<section class="sec"><div class="w"><p class="lab eb rv">Programs at North Gainesville</p><h2 class="hdg rv" style="margin-top:14px">Find the right fit</h2><p class="sub rv">Every StarMA program is offered here. Choose one to get started at this location.</p>
<div class="lpp"><div class="pi rv"><span class="tg2">Kids · Ages 6–12</span><h3>Kids Martial Arts</h3><p>Structured, high-energy classes where kids build confidence, focus, and life skills.</p><a class="lk" href="/kids-martial-arts/">Learn more</a><button class="btn p" data-gs data-p="kids" data-l="north">Start Your Trial</button></div><div class="pi rv"><span class="tg2">Ages 13 and up</span><h3>Teen &amp; Adult Martial Arts</h3><p>Kickboxing-based training for fitness, self-defense, stress relief, and community.</p><a class="lk" href="/teen-adult-martial-arts/">Learn more</a><button class="btn p" data-gs data-p="adult" data-l="north">Start Your Trial</button></div><div class="pi rv"><span class="tg2">Gainesville’s Best</span><h3>After School Program</h3><p>School pickup, active supervision, enrichment, and martial arts twice a week.</p><a class="lk" href="/after-school-program/">Learn more</a><button class="btn p" data-gs data-p="after" data-l="north">Schedule a Tour</button></div><div class="pi rv"><span class="tg2">Gainesville’s Best</span><h3>Summer Camp</h3><p>Themed weeks, field trips, pool days, and martial arts for ages 5–12.</p><a class="lk" href="/summer-camp/">Learn more</a><button class="btn p" data-gs data-p="camp" data-l="north">Explore Registration</button></div></div></div></section>

<section class="sec dk"><div class="w lpi"><div class="lph rv">Photo needed: Cristian Gomez</div><div class="rv"><p class="lab eb">Meet your lead instructor</p><h3 class="d" style="margin-top:12px">Cristian Gomez</h3><p class="rl">Lead Instructor, North Gainesville</p><p>Cristian’s StarMA story began as a student. He joined our kickboxing program at age 16, joined our instructor team once we saw his potential, and worked his way up through the ranks to Lead Instructor at North Gainesville.</p><p>His boxing background makes him the expert in our striking program, and because he grew up in our program, he knows exactly what it feels like to be a new student.</p><div class="chips"><span>2nd Degree Black Belt</span></div><p style="margin-top:18px"><a href="/about-us/">Meet the full StarMA team →</a></p></div></div></section>

<section class="sec df"><div class="w"><div class="kb" style="align-items:start"><div class="rv"><p class="lab eb">After School pickup</p><h2 class="hdg" style="margin:14px 0 16px">Schools we pick up from</h2><p style="font-size:18px;color:#444;max-width:480px">Our North Gainesville After School team provides transportation from these schools. Don’t see yours? It may be served by our <a href="/locations/west-gainesville/" style="font-weight:600;text-decoration:underline">West Gainesville</a> location, or you can <a href="/after-school-program/#as-pickup" style="font-weight:600;text-decoration:underline">search every school</a>.</p><div class="btns" style="margin-top:22px"><button class="btn p" data-gs data-p="after" data-l="north">Schedule a Tour</button><a class="btn o" href="/after-school-program/">About After School</a></div></div>
<div class="rv"><ul class="lps">{schoolsFor('north').map((s) => <li>{s}</li>)}</ul></div></div></div></section>

<LeadForm page="north" />
<section class="sec fin"><div class="w rv"><h2>Come see us at North</h2><p>Your first visit is the hardest part. We’ll make it easy.</p><div class="btns"><button class="btn p" data-gs data-l="north">Get Started</button><a class="btn ow" href="tel:3526726356">Call 352-672-6356</a><a class="btn ow" href="https://www.google.com/maps/search/?api=1&amp;query=5000+NW+34th+Blvd+Suite+5+Gainesville+FL+32605" target="_blank" rel="noopener">Get Directions</a></div></div></section>
</BaseLayout>
