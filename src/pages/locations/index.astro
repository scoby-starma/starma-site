---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locationSchema } from '../../config/schema';
const title = "Locations | Star Martial Arts, West & North Gainesville, FL";
const description = "Two Gainesville locations: West Gainesville on NW 60th St and North Gainesville on NW 34th Blvd. Kids, teen and adult martial arts, After School, and Summer Camp.";
const schema = [locationSchema('west'), locationSchema('north')];
---
<BaseLayout title={title} description={description} image="/images/g1.webp" schema={schema} pageClass="pg-locations">
<section class="ah"><div class="w kh" style="grid-template-columns:1fr"><div class="rv"><p class="bc"><a href="/">Home</a> / Locations</p><p class="lab eb">Two Gainesville locations</p><h1 class="d" style="font-size:clamp(48px,7vw,88px);margin:16px 0 20px">Two locations. One StarMA family.</h1><p class="lead" style="font-size:19px;max-width:640px">Whether you’re in West or North Gainesville, you get the same programs, the same standards, and the same team that has your back. Pick the location that fits your family’s routine.</p><div class="btns" style="margin-top:28px"><button class="btn p" data-gs>Get Started</button><a class="btn ow" href="#lp-pick">Help Me Choose</a></div><div class="chips"><span>West Gainesville</span><span>North Gainesville</span><span>All four programs at both</span></div></div></div></section>

<section class="sec"><div class="w"><p class="lab eb rv">Find us</p><h2 class="hdg rv" style="margin-top:14px">Choose your location</h2>
<div class="lpc"><article class="lpk rv"><div class="im has-bgi"><img class="bgi" src="/images/mapw.webp" alt="Map showing Star Martial Arts West Gainesville" width="900" height="734" fetchpriority="high" decoding="async"></div><div class="lb"><span class="tg2">Star Martial Arts</span><h3 class="d">West Gainesville</h3><p>500 NW 60th St, Suite A<br>Gainesville, FL 32607<br><a href="tel:3525051499">352-505-1499</a> · <a href="mailto:westgv@mystarma.com">westgv@mystarma.com</a></p><ul aria-label="Programs offered"><li>Kids Martial Arts</li><li>Teen &amp; Adult</li><li>After School</li><li>Summer Camp</li></ul><div class="btns"><a class="btn p" href="/locations/west-gainesville/">Visit West Gainesville</a><a class="btn o" href="https://www.google.com/maps/search/?api=1&amp;query=500+NW+60th+St+Suite+A+Gainesville+FL+32607" target="_blank" rel="noopener">Get Directions</a><a class="btn o" href="tel:3525051499">Call</a></div></div></article><article class="lpk rv"><div class="im has-bgi"><img class="bgi" src="/images/mapn.webp" alt="Map showing Star Martial Arts North Gainesville" width="900" height="799" loading="lazy" decoding="async"></div><div class="lb"><span class="tg2">Star Martial Arts</span><h3 class="d">North Gainesville</h3><p>5000 NW 34th Blvd, Suite 5<br>Gainesville, FL 32605<br><a href="tel:3526726356">352-672-6356</a> · <a href="mailto:northgv@mystarma.com">northgv@mystarma.com</a></p><ul aria-label="Programs offered"><li>Kids Martial Arts</li><li>Teen &amp; Adult</li><li>After School</li><li>Summer Camp</li></ul><div class="btns"><a class="btn p" href="/locations/north-gainesville/">Visit North Gainesville</a><a class="btn o" href="https://www.google.com/maps/search/?api=1&amp;query=5000+NW+34th+Blvd+Suite+5+Gainesville+FL+32605" target="_blank" rel="noopener">Get Directions</a><a class="btn o" href="tel:3526726356">Call</a></div></div></article></div></div></section>

<section class="sec df" id="lp-pick"><div class="w"><p class="lab eb rv">Which one is right for you?</p><h2 class="hdg rv" style="margin:14px 0 0">Three easy ways to decide</h2>
<div class="lpv"><div class="pi rv"><h3>Closest to your routine</h3><p>Choose the location nearest to home, school, or work. Consistency is what builds results, so the easier it is to get to class, the better.</p></div>
<div class="pi rv"><h3>After School? Start with the school</h3><p>Your child’s After School location depends on where they attend school. <a href="/after-school-program/#as-pickup">Look up your school</a> to see which StarMA location picks up from it.</p></div>
<div class="pi rv"><h3>Same standard everywhere</h3><p>Both locations share the same programs, class structure, core values, and commitment to safe, clean, professional facilities.</p></div></div></div></section>

<section class="sec dk"><div class="w kb"><div class="rv"><p class="lab eb">At both locations</p><h2 class="hdg" style="margin:14px 0 16px">What every StarMA family can count on</h2><p style="font-size:18px;color:#E4E4E4">No matter which location you choose, you’re joining the same community and the same way of doing things.</p><ul><li>Members First: our members come before everything else</li><li>Active Supervision, every class and every day</li><li>Safe, clean, professional facilities</li><li>Confidence, character, and life skills built into every class</li><li>A team that knows your name and notices your progress</li></ul></div>
<div class="im rv has-bgi" style="height:420px;border-radius:12px;"><img class="bgi" src="/images/g1.webp" alt="Students lined up at attention at the start of class" width="1100" height="733" loading="lazy" decoding="async" style="object-position:center 40%"></div></div></section>

<section class="sec fin"><div class="w rv"><h2>Ready to see us in person?</h2><p>Choose a program and location, and we’ll take it from there.</p><div class="btns"><button class="btn p" data-gs>Get Started</button><a class="btn ow" href="tel:3525051499">Call West</a><a class="btn ow" href="tel:3526726356">Call North</a></div></div></section>
</BaseLayout>
