---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { locationSchema } from '../../config/schema';
import { SCHOOLS } from '../../config/site';
const schoolsFor = (k: string) => SCHOOLS.filter((s) => (s[2] as string[]).includes(k)).map((s) => s[0] as string);
const title = "Martial Arts in West Gainesville, FL (NW 60th St) | Star Martial Arts";
const description = "Star Martial Arts West Gainesville, 500 NW 60th St, Suite A. Kids and adult martial arts, After School pickup, and Summer Camp. Call 352-505-1499.";
const schema = [locationSchema('west')];
---
<BaseLayout title={title} description={description} image="/images/mapw.webp" schema={schema} pageClass="pg-west">
<section class="ah"><div class="w kh"><div class="rv"><p class="bc"><a href="/">Home</a> / <a href="/locations/">Locations</a> / West Gainesville</p><p class="lab eb">Star Martial Arts · West Gainesville</p><h1 class="d" style="font-size:clamp(48px,7vw,88px);margin:16px 0 20px">West Gainesville</h1><p class="lead" style="font-size:19px;max-width:540px">Martial arts, After School, and Summer Camp on Gainesville’s west side. Come train with a team that has your back.</p><div class="btns" style="margin-top:28px"><button class="btn p" data-gs data-l="west">Get Started at West</button><a class="btn ow" href="tel:3525051499">Call 352-505-1499</a></div><div class="chips"><span>500 NW 60th St, Suite A</span><span>All four programs</span></div></div>
<div class="lpm rv has-bgi"><img class="bgi" src="/images/mapw.webp" alt="Map showing Star Martial Arts West Gainesville" width="900" height="734" fetchpriority="high" decoding="async"></div></div></section>

<section class="sec dk lpd"><div class="w kb"><div class="rv"><p class="lab eb">Visit us</p><h2 class="hdg" style="margin:14px 0 4px">Find West Gainesville</h2><dl><dt>Address</dt><dd>500 NW 60th St, Suite A<br>Gainesville, FL 32607</dd><dt>Phone</dt><dd><a href="tel:3525051499">352-505-1499</a></dd><dt>Email</dt><dd><a href="mailto:westgv@mystarma.com">westgv@mystarma.com</a></dd><dt>Schedule</dt><dd>Multiple class times Monday through Friday. You’ll see current times after you choose a program in Get Started.</dd></dl><div class="btns"><a class="btn p" href="https://www.google.com/maps/search/?api=1&amp;query=500+NW+60th+St+Suite+A+Gainesville+FL+32607" target="_blank" rel="noopener">Get Directions</a><a class="btn ow" href="mailto:westgv@mystarma.com">Email This Location</a></div></div>
<div class="rv"><p class="lab eb">Before your first visit</p><ul style="margin-top:14px"><li>Arrive a few minutes early. At StarMA, early is on time.</li><li>Wear comfortable workout clothes. Your first uniform is provided at no cost when you enroll.</li><li>Bring water and any questions you have. Our team is happy to help.</li><li>Parents are welcome to watch and meet the instructors.</li></ul></div></div></section>

<section class="sec"><div class="w"><p class="lab eb rv">Programs at West Gainesville</p><h2 class="hdg rv" style="margin-top:14px">Find the right fit</h2><p class="sub rv">Every StarMA program is offered here. Choose one to get started at this location.</p>
<div class="lpp"><div class="pi rv"><span class="tg2">Kids · Ages 6–12</span><h3>Kids Martial Arts</h3><p>Structured, high-energy classes where kids build confidence, focus, and life skills.</p><a class="lk" href="/kids-martial-arts/">Learn more</a><button class="btn p" data-gs data-p="kids" data-l="west">Start Your Trial</button></div><div class="pi rv"><span class="tg2">Ages 13 and up</span><h3>Teen &amp; Adult Martial Arts</h3><p>Kickboxing-based training for fitness, self-defense, stress relief, and community.</p><a class="lk" href="/teen-adult-martial-arts/">Learn more</a><button class="btn p" data-gs data-p="adult" data-l="west">Start Your Trial</button></div><div class="pi rv"><span class="tg2">Gainesville’s Best</span><h3>After School Program</h3><p>School pickup, active supervision, enrichment, and martial arts twice a week.</p><a class="lk" href="/after-school-program/">Learn more</a><button class="btn p" data-gs data-p="after" data-l="west">Schedule a Tour</button></div><div class="pi rv"><span class="tg2">Gainesville’s Best</span><h3>Summer Camp</h3><p>Themed weeks, field trips, pool days, and martial arts for ages 5–12.</p><a class="lk" href="/summer-camp/">Learn more</a><button class="btn p" data-gs data-p="camp" data-l="west">Explore Registration</button></div></div></div></section>

<section class="sec dk"><div class="w lpi"><div class="im rv has-bgi"><img class="bgi" src="/images/sg.webp" alt="Sage Bachus, Lead Instructor, West Gainesville" width="600" height="800" loading="lazy" decoding="async"></div><div class="rv"><p class="lab eb">Meet your lead instructor</p><h3 class="d" style="margin-top:12px">Sage Bachus</h3><p class="rl">Lead Instructor, West Gainesville</p><p>Sage has trained in taekwondo for 13 years and holds a 4th degree black belt. He is one of two members of the inaugural class of Hyper Black Belts, earning his 1st degree black belt in kickboxing, and graduated from the University of Florida in 2025 with a bachelor’s degree in engineering.</p><p>He’s excited to work with the next generation of leaders and inspire students to take charge and lead their generation.</p><div class="chips"><span>4th Degree Black Belt</span><span>1st Degree Black Belt, Kickboxing</span><span>Inaugural Hyper Black Belt</span></div><p style="margin-top:18px"><a href="/about-us/">Meet the full StarMA team →</a></p></div></div></section>

<section class="sec df"><div class="w"><div class="kb" style="align-items:start"><div class="rv"><p class="lab eb">After School pickup</p><h2 class="hdg" style="margin:14px 0 16px">Schools we pick up from</h2><p style="font-size:18px;color:#444;max-width:480px">Our West Gainesville After School team provides transportation from these schools. Don’t see yours? It may be served by our <a href="/locations/north-gainesville/" style="font-weight:600;text-decoration:underline">North Gainesville</a> location, or you can <a href="/after-school-program/#as-pickup" style="font-weight:600;text-decoration:underline">search every school</a>.</p><div class="btns" style="margin-top:22px"><button class="btn p" data-gs data-p="after" data-l="west">Schedule a Tour</button><a class="btn o" href="/after-school-program/">About After School</a></div></div>
<div class="rv"><ul class="lps">{schoolsFor('west').map((s) => <li>{s}</li>)}</ul></div></div></div></section>

<LeadForm page="west" />
<section class="sec fin"><div class="w rv"><h2>Come see us at West</h2><p>Your first visit is the hardest part. We’ll make it easy.</p><div class="btns"><button class="btn p" data-gs data-l="west">Get Started</button><a class="btn ow" href="tel:3525051499">Call 352-505-1499</a><a class="btn ow" href="https://www.google.com/maps/search/?api=1&amp;query=500+NW+60th+St+Suite+A+Gainesville+FL+32607" target="_blank" rel="noopener">Get Directions</a></div></div></section>
</BaseLayout>
