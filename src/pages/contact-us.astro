---
import BaseLayout from '../layouts/BaseLayout.astro';
import SmsConsent from '../components/SmsConsent.astro';
const title = "Contact Us | Star Martial Arts, Gainesville, FL";
const description = "Call, email, or message Star Martial Arts West or North Gainesville. Questions about classes, After School, or Summer Camp? We’ll get back to you.";
const schema = [];
---
<BaseLayout title={title} description={description} image="/images/hero.webp" schema={schema} pageClass="pg-contact">
<section class="ah"><div class="w kh" style="grid-template-columns:1fr"><div class="rv"><p class="bc"><a href="/">Home</a> / Contact Us</p><p class="lab eb">Contact Star Martial Arts</p><h1 class="d" style="font-size:clamp(48px,7vw,88px);margin:16px 0 20px">We’d love to hear from you.</h1><p class="lead" style="font-size:19px;max-width:620px">Questions about classes, After School, Summer Camp, or getting started? Call, email, or send us a message and your local team will get back to you.</p></div></div></section>
<section class="sec"><div class="w"><p class="lab eb rv">Call, email, or visit</p><h2 class="hdg rv" style="margin:14px 0 28px">Two Gainesville locations</h2><div class="ccg"><article class="cc rv"><div class="im has-bgi" style="height:auto;min-height:240px;"><img class="bgi" src="/images/mapw.webp" alt="Map showing Star Martial Arts West Gainesville" width="900" height="734" fetchpriority="high" decoding="async" style="object-position:center"></div><div class="cb"><h3 class="d">West Gainesville</h3><p>500 NW 60th St, Suite A<br>Gainesville, FL 32607</p><p><a href="tel:3525051499">352-505-1499</a><br><a href="mailto:westgv@mystarma.com">westgv@mystarma.com</a></p><div class="btns"><a class="btn p" href="tel:3525051499">Call West</a><a class="btn o" href="https://www.google.com/maps/search/?api=1&amp;query=500+NW+60th+St+Suite+A+Gainesville+FL+32607" target="_blank" rel="noopener">Get Directions</a></div></div></article><article class="cc rv"><div class="im has-bgi" style="height:auto;min-height:240px;"><img class="bgi" src="/images/mapn.webp" alt="Map showing Star Martial Arts North Gainesville" width="900" height="799" loading="lazy" decoding="async" style="object-position:center"></div><div class="cb"><h3 class="d">North Gainesville</h3><p>5000 NW 34th Blvd, Suite 5<br>Gainesville, FL 32605</p><p><a href="tel:3526726356">352-672-6356</a><br><a href="mailto:northgv@mystarma.com">northgv@mystarma.com</a></p><div class="btns"><a class="btn p" href="tel:3526726356">Call North</a><a class="btn o" href="https://www.google.com/maps/search/?api=1&amp;query=5000+NW+34th+Blvd+Suite+5+Gainesville+FL+32605" target="_blank" rel="noopener">Get Directions</a></div></div></article></div></div></section>
<section class="sec df" id="contact-form"><div class="w"><div class="ldg"><div><p class="lab eb">Send a message</p><h2 class="hdg" style="margin:14px 0 16px">Ask us anything.</h2><p style="font-size:18px;color:#444;max-width:480px">Choose your location and your message goes to that team. Prefer to talk? Call West at <a href="tel:3525051499">352-505-1499</a> or North at <a href="tel:3526726356">352-672-6356</a>.</p><p style="font-size:18px;color:#444;max-width:480px;margin-top:16px">Ready to get started? <button type="button" data-gs style="font:inherit;font-weight:600;text-decoration:underline;background:none;border:0;padding:0;cursor:pointer;color:inherit">Choose a program and location</button>, or book a tour online from our <a href="/after-school-program/" style="font-weight:600;text-decoration:underline">After School</a> page.</p></div>
<form class="ld-f" id="cuf" novalidate=""><div class="ldf"><label for="cu-n">Your name</label><input id="cu-n" name="name" autocomplete="name" required=""><p class="er" role="alert"></p>
<label for="cu-p">Phone number</label><input id="cu-p" name="phone" type="tel" autocomplete="tel" required=""><p class="er" role="alert"></p>
<label for="cu-e">Email address (optional)</label><input id="cu-e" name="email" type="email" autocomplete="email"><p class="er" role="alert"></p>
<fieldset><legend>Which location?</legend><div class="rdl"><label><input type="radio" name="loc" value="West Gainesville"> West Gainesville</label><label><input type="radio" name="loc" value="North Gainesville"> North Gainesville</label></div><p class="er" role="alert"></p></fieldset>
<label for="cu-t">What can we help with?</label><select id="cu-t" name="topic"><option>General question</option><option>Kids Martial Arts (ages 6–12)</option><option>Teen &amp; Adult Martial Arts (13+)</option><option>After School Program</option><option>Summer Camp</option><option>Something else</option></select>
<label for="cu-m">Your message</label><textarea id="cu-m" name="msg" rows="4" required=""></textarea><p class="er" role="alert"></p>
<SmsConsent name="sms" />
<input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"><button class="btn p" type="submit">Send Message</button><p class="ln">We use your information only to respond to your request. We never sell or share your phone number for marketing.</p><div class="ls" role="status" aria-live="polite"></div></div></form></div></div></section>
</BaseLayout>
