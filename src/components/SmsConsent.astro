---
/*
 * Text-message consent checkbox used on every form.
 * This wording was cleared for A2P 10DLC review. Change it only with legal sign-off,
 * and keep it matching the Privacy Policy & SMS Terms page.
 */
interface Props {
  name?: string;
}
const { name = 'sms' } = Astro.props;
---
<div class="sms"><label><input type="checkbox" name={name} value="yes"> <span><b>Yes, text me!</b> I agree to receive text messages from Star Martial Arts at the phone number above about my inquiry, including program information, scheduling, and reminders. Consent is optional and not a condition of any purchase or enrollment. Message frequency varies. Message and data rates may apply. Reply STOP to opt out or HELP for help. See our <a href="/privacy-policy/" target="_blank">Privacy Policy &amp; SMS Terms</a>.</span></label></div>
